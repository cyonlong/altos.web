,{"path":"/txt/27256/16217930","titleZh":"V041"},{"path":"/txt/27256/16201158","titleZh":"V040"},{"path":"/txt/27256/16196506","titleZh":"V039"},{"path":"/txt/27256/16186915","titleZh":"V038"},{"path":"/txt/27256/16179658","titleZh":"V037"},{"path":"/txt/27256/16111302","titleZh":"V036"},{"path":"/txt/27256/16086457","titleZh":"V035"},{"path":"/txt/27256/16079385","titleZh":"V034"},{"path":"/txt/27256/16079384","titleZh":"V033 她绝对不能有事，绝对不能"},{"path":"/txt/27256/16077033","titleZh":"V032 他是我的儿子，也是天生的王者"},{"path":"/txt/27256/16077032","titleZh":"V031"},{"path":"/txt/27256/16077031","titleZh":"V030"},{"path":"/txt/27256/16077030","titleZh":"V029"},{"path":"/txt/27256/16077029","titleZh":"V028"},{"path":"/txt/27256/16077028","titleZh":"V027"},{"path":"/txt/27256/16077027","titleZh":"V026 一只白色的鸟儿"},{"path":"/txt/27256/16077025","titleZh":"V025 他呢，到底是经历什么？"},{"path":"/txt/27256/16077024","titleZh":"V024 蛊毒爆发了"},{"path":"/txt/27256/16077023","titleZh":"V023 秦晚歌被掳走了"},{"path":"/txt/27256/16077022","titleZh":"V022 如果他做了皇帝，指点江山，是否会离她"},{"path":"/txt/27256/16077021","titleZh":"V021 明日从救护处带几个染了瘟疫的贱民，一"},{"path":"/txt/27256/16077020","titleZh":"V020 因为本王是凤无殇（一万）"},{"path":"/txt/27256/16077019","titleZh":"V019 凤无殇，真的逃不过死亡的命运吗？"},{"path":"/txt/27256/16077018","titleZh":"V018 你知道吗， 在我心中神秘强大的战王就"},{"path":"/txt/27256/16077017","titleZh":"V017 向来无情无愫无牵挂的他，如今还要像是"},{"path":"/txt/27256/16077016","titleZh":"V016 凤无殇苦笑，还真是拿这个女人一点办法"},{"path":"/txt/27256/16077015","titleZh":"V015 从影子上看，他们的身影纠缠在一起，紧"},{"path":"/txt/27256/16077014","titleZh":"V014 我从来没有想到你会说出今天这样的话。"},{"path":"/txt/27256/16077013","titleZh":"V013 他不想给秦晚歌一个希望，到最后却变成"},{"path":"/txt/27256/16077012","titleZh":"V012 凤无殇，你也太狠了吧？"},{"path":"/txt/27256/16077011","titleZh":"V011 你究竟有什么样的故事？"},{"path":"/txt/27256/16077010","titleZh":"V010 脸上几乎都糊着泥巴，她冲着凤清尘是傻"},{"path":"/txt/27256/16077009","titleZh":"V009 从江南回来之后，主动来本王的王府，住"},{"path":"/txt/27256/16077008","titleZh":"V008 我和他现在感情很好，我一刻都不能离开"},{"path":"/txt/27256/16077007","titleZh":"V007 凤清尘，我秦晚歌会一步步的报仇，我要"},{"path":"/txt/27256/16077006","titleZh":"V006 京城都在传着，战王对你是盛宠，有求必"},{"path":"/txt/27256/16077005","titleZh":"V005 秦千羽这个自傲的小姐吓得直直跌倒在地"},{"path":"/txt/27256/16077004","titleZh":"V004 刑部的场景真是一场别开生面有趣的闹剧"},{"path":"/txt/27256/16077003","titleZh":"V003 人若害她，她必还之十倍！"},{"path":"/txt/27256/16077002","titleZh":"V002朝中大臣都议论纷纷，金元王朝的另一个"},{"path":"/txt/27256/16077001","titleZh":"V001 她什么时候招惹了这个混世王爷？"},{"path":"/txt/27256/16076999","titleZh":"107 把希望寄托在战王身上了"},{"path":"/txt/27256/16076998","titleZh":"106 你最怕的是什么东西？"},{"path":"/txt/27256/16076997","titleZh":"105 又一道难题"},{"path":"/txt/27256/16076996","titleZh":"104 是爱妃衣裳不整，又不是本王"},{"path":"/txt/27256/16076995","titleZh":"103 和战王竟如此亲热，这真是百年难得一见"},{"path":"/txt/27256/16076994","titleZh":"102 刚才，跳的很好，本王很喜欢"},{"path":"/txt/27256/16076993","titleZh":"101 他们惊愕，这还是当初的秦晚歌吗？"},{"path":"/txt/27256/16076992","titleZh":"100 她们现在有多么随意糟蹋，一会就让她们"},{"path":"/txt/27256/16076991","titleZh":"099 果然这三王爷和她命格犯冲"},{"path":"/txt/27256/16076990","titleZh":"098 气质出众，真是……特别的美"},{"path":"/txt/27256/16076989","titleZh":"097 气氛颇有尴尬"},{"path":"/txt/27256/16076988","titleZh":"096 公主不是公主"},{"path":"/txt/27256/16076987","titleZh":"095 那抹身影不是黑色，没有披着黑色披风"},{"path":"/txt/27256/16076986","titleZh":"094 披风在，你在，披风乱，你死"},{"path":"/txt/27256/16076985","titleZh":"093 众人面前衣装不整，王妃可有考虑本王的"},{"path":"/txt/27256/16076984","titleZh":"092 她似乎和往常不一样"},{"path":"/txt/27256/16076983","titleZh":"091 命悬一线"},{"path":"/txt/27256/16076982","titleZh":"090 一定要阻止秦晚歌登台献舞"},{"path":"/txt/27256/16076981","titleZh":"089 真是有点像那冰山皇叔了"},{"path":"/txt/27256/16076980","titleZh":"088 都没心情看表演"},{"path":"/txt/27256/16076979","titleZh":"087 还能不能愉快的交谈了"},{"path":"/txt/27256/16076978","titleZh":"086 端着这酒樽，不要洒出来"},{"path":"/txt/27256/16076977","titleZh":"085 侄子大有前途啊！"},{"path":"/txt/27256/16076975","titleZh":"084 爱妃少饮，免得胡话"},{"path":"/txt/27256/16076974","titleZh":"083 众人皆是嫉妒要命"},{"path":"/txt/27256/16076973","titleZh":"082 他们姿态高调，举止亲密"},{"path":"/txt/27256/16076972","titleZh":"081 难道只是为了证明无才无德的王妃能歌善"},{"path":"/txt/27256/16076971","titleZh":"080 她没看到凤无殇嘴角那一闪而过的笑容"},{"path":"/txt/27256/16076970","titleZh":"079 他像是恶魔一般，嗜血的笑容，招呼着她"},{"path":"/txt/27256/16076969","titleZh":"078 本王自会解决，你无须多虑"},{"path":"/txt/27256/16076968","titleZh":"077 聂枫侍卫的武功真……糟糕"},{"path":"/txt/27256/16076967","titleZh":"076 啊，回门礼？这都赶上聘礼了"},{"path":"/txt/27256/16076966","titleZh":"075 十辆高调的马车"},{"path":"/txt/27256/16076965","titleZh":"074 新王妃不禁蛮横无理，而且还贪财无厌"},{"path":"/txt/27256/16076964","titleZh":"073 三年来他都在做同一个梦"},{"path":"/txt/27256/16076963","titleZh":"072 秦晚歌，你有趣过头了"},{"path":"/txt/27256/16076962","titleZh":"071 她一辈子的命运都与战王府紧紧相连"},{"path":"/txt/27256/16076961","titleZh":"070 不知是福是祸，但求对的起自心。"},{"path":"/txt/27256/16076960","titleZh":"069 他冷峻的嘴唇闪过一丝笑意"},{"path":"/txt/27256/16076959","titleZh":"068 人要自己看得起自己"},{"path":"/txt/27256/16076958","titleZh":"067 天下又多了两桩关于战王的传闻"},{"path":"/txt/27256/16076957","titleZh":"066 随便他们叫骂吧，让他们好好后悔去"},{"path":"/txt/27256/16076956","titleZh":"065 一群苍蝇"},{"path":"/txt/27256/16076955","titleZh":"064 京城新八卦"},{"path":"/txt/27256/16076954","titleZh":"063 一个名衔而已"},{"path":"/txt/27256/16076953","titleZh":"062 明争暗斗太狠了,还是伺候皇上比较好"},{"path":"/txt/27256/16076952","titleZh":"061 负荆请罪"},{"path":"/txt/27256/16076951","titleZh":"060 我要绝处逢生"},{"path":"/txt/27256/16076949","titleZh":"059 三方人马齐聚秦家"},{"path":"/txt/27256/16076948","titleZh":"058 绝不能让你成为我一生的耻辱！"},{"path":"/txt/27256/16076947","titleZh":"057 该死的秦晚歌"},{"path":"/txt/27256/16076946","titleZh":"056 她能相信他吗？"},{"path":"/txt/27256/16076945","titleZh":"055 我不相信别人，我只相信自己"},{"path":"/txt/27256/16076944","titleZh":"054 她在这些人眼中是多么的好欺负"},{"path":"/txt/27256/16076943","titleZh":"053 慕家必然倾尽所有，保你一命"},{"path":"/txt/27256/16076942","titleZh":"052 三皇子凤清歌"},{"path":"/txt/27256/16076941","titleZh":"051 我的名声有多臭，二皇子脸上就多无光"},{"path":"/txt/27256/16076940","titleZh":"050 一损俱损"},{"path":"/txt/27256/16076938","titleZh":"049 主子的心思不能随便猜"},{"path":"/txt/27256/16076937","titleZh":"048 他要禀明父皇，赐死这个女人"},{"path":"/txt/27256/16076936","titleZh":"047 我要退婚"},{"path":"/txt/27256/16076934","titleZh":"046 感受到他的魅力，她想逃离"},{"path":"/txt/27256/16076932","titleZh":"045 这场游戏，已经不单是输赢那么简单了"},{"path":"/txt/27256/16076931","titleZh":"044 小姐到底要不要嫁呢"},{"path":"/txt/27256/16076930","titleZh":"043 若除掉慕家，他就是下一任君主"},{"path":"/txt/27256/16076928","titleZh":"042 当务之急是怎么让他们同意"},{"path":"/txt/27256/16076927","titleZh":"041 想姑奶奶嫁给你，做梦去吧！"},{"path":"/txt/27256/16076926","titleZh":"040 她爱的是皇后的宝座"},{"path":"/txt/27256/16076925","titleZh":"039 秦千羽嫁过去肯定有趣"},{"path":"/txt/27256/16076924","titleZh":"038 秦家耳目众多"},{"path":"/txt/27256/16076923","titleZh":"037 还想榨干她的价值"},{"path":"/txt/27256/16076922","titleZh":"036 秦千羽,你太让我失望了"},{"path":"/txt/27256/16076921","titleZh":"035 礼物不求贵重,只求心意"},{"path":"/txt/27256/16076920","titleZh":"034 简直太不要脸了"},{"path":"/txt/27256/16076919","titleZh":"033 哪有这样的爹"},{"path":"/txt/27256/16076917","titleZh":"032 她的形象是彻底毁了"},{"path":"/txt/27256/16076916","titleZh":"031 以死明志"},{"path":"/txt/27256/16076915","titleZh":"030 此人必不简单"},{"path":"/txt/27256/16076914","titleZh":"029 秦晚歌，算你狠"},{"path":"/txt/27256/16076913","titleZh":"028 有她们傻眼的时候"},{"path":"/txt/27256/16076912","titleZh":"027 谁也没注意她眼角的讥讽"},{"path":"/txt/27256/16076911","titleZh":"026 等着明日看好戏"},{"path":"/txt/27256/16076910","titleZh":"025 明日我要所有人看到她丑陋的面目"},{"path":"/txt/27256/16076909","titleZh":"024 为了凤清尘什么都能做出来"},{"path":"/txt/27256/16076908","titleZh":"023 她对尊严的渴望比谁都重"},{"path":"/txt/27256/16076906","titleZh":"022 她要她被天下人羞辱致死"},{"path":"/txt/27256/16076905","titleZh":"021 凤清尘急了"},{"path":"/txt/27256/16076904","titleZh":"020 她成了掌握秦家沉浮高升的命脉"},{"path":"/txt/27256/16076903","titleZh":"019 这一战，大获全胜"},{"path":"/txt/27256/16076902","titleZh":"018 神秘男子"},{"path":"/txt/27256/16076901","titleZh":"017 怒打凤清尘"},{"path":"/txt/27256/16076900","titleZh":"016 前往花满楼"},{"path":"/txt/27256/16076899","titleZh":"015 那个如神一般的男子"},{"path":"/txt/27256/16076898","titleZh":"014 唯有一人可助慕家"},{"path":"/txt/27256/16076897","titleZh":"013 今后绝不会让舅舅为难"},{"path":"/txt/27256/16076896","titleZh":"012 只要我出手，必然触到她命脉"},{"path":"/txt/27256/16076895","titleZh":"011 又是个蠢女人"},{"path":"/txt/27256/16076894","titleZh":"010 他绝对是只狐狸"},{"path":"/txt/27256/16076893","titleZh":"009 她倒要看看他们演技到底有多好"},{"path":"/txt/27256/16076892","titleZh":"008 二皇子凤清尘"},{"path":"/txt/27256/16076891","titleZh":"007 这么简单的事情怎么就没想明白呢"},{"path":"/txt/27256/16076890","titleZh":"006 定情还是订婚自己去想吧"},{"path":"/txt/27256/16076889","titleZh":"005 这场唇枪舌战，她赢的漂亮！"},{"path":"/txt/27256/16076888","titleZh":"004 原来她就是告状的人"},{"path":"/txt/27256/16076887","titleZh":"003 这丫头几日不见，倒是聪明了几分"},{"path":"/txt/27256/16076886","titleZh":"002 欠我的都要还给我"},{"path":"/txt/27256/16076885","titleZh":"001 重生的机会"}]}