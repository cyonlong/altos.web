{"schema":1,"novelKey":"69shuba:1197","summaryZh":"\u0026nbsp;\u0026nbsp;\u0026nbsp;\u0026nbsp;50年前由长沙土夫子（盗墓贼）出土的战国帛书，记载了一个奇特战国古墓的位置，50年后，其中一个土夫子的孙子在他的笔记中发现这个秘密，纠集了一批经验丰富的盗墓贼前去寻宝，谁也没有想到，这个古墓竟然有着这么多诡异的事情：七星疑棺，青眼狐尸，九头蛇柏。这神秘的墓主人到底是谁，他们到底能不能找到真正的棺椁？故事悬念重重，情节跌荡，值得一看。","tagsVi":[],"chapterTitles":[{"path":"/txt/1197/30374563","titleZh":"第1章 七星鲁王 血尸"},{"path":"/txt/1197/30374564","titleZh":"第2章 七星鲁王 50年后"},{"path":"/txt/1197/30374565","titleZh":"第3章 七星鲁王 瓜子庙"},{"path":"/txt/1197/30374566","titleZh":"第4章 七星鲁王 尸洞"},{"path":"/txt/1197/30374567","titleZh":"第5章 七星鲁王 水影"},{"path":"/txt/1197/30374568","titleZh":"第6章 七星鲁王 积尸地"},{"path":"/txt/1197/30374569","titleZh":"第7章 七星鲁王 100多个人头"},{"path":"/txt/1197/30374570","titleZh":"第8章 七星鲁王 山谷"},{"path":"/txt/1197/30374571","titleZh":"第9章 七星鲁王 古墓"},{"path":"/txt/1197/30374572","titleZh":"第10章 七星鲁王 影子"},{"path":"/txt/1197/30374573","titleZh":"第11章 七星鲁王 七星棺"},{"path":"/txt/1197/30374574","titleZh":"第12章 七星鲁王 门"},{"path":"/txt/1197/30374575","titleZh":"第13章 七星鲁王 02200059"},{"path":"/txt/1197/30374576","titleZh":"第14章 七星鲁王 闷油瓶"},{"path":"/txt/1197/30374577","titleZh":"第15章 七星鲁王 屁"},{"path":"/txt/1197/30374578","titleZh":"第16章 七星鲁王 小手"},{"path":"/txt/1197/30374579","titleZh":"第17章 七星鲁王 洞"},{"path":"/txt/1197/30374580","titleZh":"第18章 七星鲁王 大树"},{"path":"/txt/1197/30374581","titleZh":"第19章 七星鲁王 女尸"},{"path":"/txt/1197/30374582","titleZh":"第20章 七星鲁王 钥匙"},{"path":"/txt/1197/30374583","titleZh":"第21章 七星鲁王 青眼狐尸"},{"path":"/txt/1197/30374584","titleZh":"第22章 七星鲁王 八重宝函"},{"path":"/txt/1197/30374585","titleZh":"第23章 七星鲁王 棺椁"},{"path":"/txt/1197/30374586","titleZh":"第24章 七星鲁王 活尸"},{"path":"/txt/1197/30374587","titleZh":"第25章 七星鲁王 玉俑"},{"path":"/txt/1197/30374588","titleZh":"第26章 七星鲁王 紫玉匣子"},{"path":"/txt/1197/30374589","titleZh":"第27章 七星鲁王 谎言"},{"path":"/txt/1197/30374590","titleZh":"第28章 七星鲁王 火"},{"path":"/txt/1197/30374591","titleZh":"第29章 七星鲁王 紫金匣"},{"path":"/txt/1197/30374592","titleZh":"第30章 怒海潜沙 蛇眉铜鱼"},{"path":"/txt/1197/30374593","titleZh":"第31章